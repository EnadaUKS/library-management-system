digraph ER {
  rankdir=LR;
  fontname="Helvetica";
  node [shape=record, fontname="Helvetica" fontsize=10, style=filled, fillcolor="#fff6e0", color="#8a6d00"];
  edge [fontname="Helvetica" fontsize=9];

  USERS [label="{USERS|id (PK)\lname\lemail\lpassword_hash\lrole\l}"];
  BOOKS [label="{BOOKS|id (PK)\ltitle\lauthor\lisbn\lcategory_id (FK)\ltotal_copies\lavailable_copies\l}"];
  CATEGORIES [label="{CATEGORIES|id (PK)\lname\l}"];
  LOANS [label="{LOANS|id (PK)\luser_id (FK)\lbook_id (FK)\lloan_date\ldue_date\lreturn_date\lstatus\l}"];

  USERS -> LOANS [label="1..*"];
  BOOKS -> LOANS [label="1..*"];
  CATEGORIES -> BOOKS [label="1..*"];
}
